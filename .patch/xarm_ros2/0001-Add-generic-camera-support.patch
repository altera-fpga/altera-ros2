diff --git a/xarm_description/urdf/camera/generic_camera.urdf.xacro b/xarm_description/urdf/camera/generic_camera.urdf.xacro
new file mode 100644
index 0000000..8d646de
--- /dev/null
+++ b/xarm_description/urdf/camera/generic_camera.urdf.xacro
@@ -0,0 +1,31 @@
+<?xml version="1.0"?>
+<robot xmlns:xacro="http://ros.org/wiki/xacro">
+  <xacro:macro name="camera_urdf" params="prefix:='' add_camera_links:=false">
+
+    <!-- define property -->
+    <xacro:property name="M_PI" value="3.1415926535897931" />
+    
+    <link name="${prefix}link_eef"><xacro:common_link_visual mesh_filename="camera/realsense/visual/d435_with_cam_stand" origin_xyz="0 0 0" origin_rpy="0 0 0" material_name="${prefix}Silver" /><xacro:common_link_collision mesh_filename="camera/realsense/collision/d435_with_cam_stand" origin_xyz="0 0 0" origin_rpy="0 0 0" /></link>
+
+    <xacro:if value="${add_camera_links}">
+
+      <link name="${prefix}xarm_camera_link"></link>
+
+      <link name="${prefix}xarm_camera_color_optical_frame"></link>
+
+      <joint name="${prefix}xarm_camera_link_joint" type="fixed">
+        <parent link="${prefix}link_eef" />
+        <child link="${prefix}xarm_camera_link" />
+        <origin xyz="0.06746 0.00 0.00" rpy="${M_PI} ${-M_PI/2} 0" />
+      </joint>
+
+      <joint name="${prefix}xarm_camera_color_optical_joint" type="fixed">
+        <parent link="${prefix}xarm_camera_link" />
+        <child link="${prefix}xarm_camera_color_optical_frame" />
+        <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
+      </joint>
+
+    </xacro:if>
+
+  </xacro:macro>
+</robot>
